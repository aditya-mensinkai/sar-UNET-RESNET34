# Large files: raw SAR dataset, linked/copied imagery, caches — never commit these.

# Raw dataset (136 GB, external source: Zenodo 8346860 / 8253899 / 13761290)
/dataset/

# Python environment
.venv/
__pycache__/
*.py[cod]
*.egg-info/

# TIFF imagery anywhere (processed_dataset train/val/test hold hard links of dataset/)
*.tif
*.tiff
*.7z

# Derived image-data directories (reproducible via tools/create_dataset_split.py)
processed_dataset/train/
processed_dataset/val/
processed_dataset/test/
processed_dataset/tiled/
processed_dataset/augmented/
processed_dataset/stitched/

# OS / editor noise
Thumbs.db
Desktop.ini
.vscode/
.idea/

# Scratch verification scripts (never committed)
tools/tmp_*.py

# Model checkpoints / training outputs (large, regenerable)
*.pt
*.pth
*.ckpt
checkpoints/
lightning_logs/
runs/

# Run outputs (regenerable — rerun the tool to reproduce)
results/
evaluation/
run_logs/
processed_dataset/tile_cache/

# Per-scene analysis cache (regenerable via tools/val_analysis.py)
*.npz

# One-off benchmark / smoke logs at repo root
smoke_results.txt
bench_results*.txt

# Investigation artifacts: reservoir pools, census dumps (live in %TEMP%, must
# never be committed if copied into the repo)
*.npy
audit_out*.json
